# ---- LLM / embeddings (Google Gemini) ----
GOOGLE_API_KEY=

# ---- Accounts (each user signs up / signs in; documents are private per user) ----
# Set ALLOW_REGISTRATION=false to stop self-sign-up and create accounts with
#   python -m rag_agent.users create <username>
ALLOW_REGISTRATION=true
USERS_DB_PATH=./users.sqlite
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:8080

# ---- Web search (optional; leave empty to use keyless DuckDuckGo) ----
TAVILY_API_KEY=

# ---- LangSmith observability + evals (optional; set TRACING=true and add a key to enable) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resume-demo-rag-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Models (override defaults if desired) ----
MODEL_FAST=gemini-2.5-flash-lite
MODEL_HEAVY=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-2

# ---- Storage / retrieval ----
CHROMA_DIR=./chroma_db
SQLITE_PATH=./memory.sqlite
RETRIEVER_K=4
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_COUNT=10
